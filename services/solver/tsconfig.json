{
  "compilerOptions": {
    "target": "esnext",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "types/*": ["../../types/*"]
    }
  }
}